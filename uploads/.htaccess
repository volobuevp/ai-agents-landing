# Папка вложений формы: только отдача файлов.
# Листинг отключён — файл достижим исключительно по прямой ссылке
# с неугадываемым именем (см. send.php).
Options -Indexes

# Исполняемое в папке вложений запрещено — файлы сюда попадают
# только через белый список расширений в send.php, но подстраховка
# не помешает: даже загруженный .php не запустится.
<FilesMatch "\.(php|phtml|php[0-9]+|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>

# dl.php — единственное исключение: скрипт отдачи вложений на скачивание.
# Заголовок Content-Disposition: attachment ставит сам скрипт: заголовки
# из .htaccess на этом хостинге не проходят (AllowOverride их режет),
# а статику мимо Apache всё равно отдаёт nginx.
<Files "dl.php">
  Require all granted
</Files>